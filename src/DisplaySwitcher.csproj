<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DisplaySwitcher</AssemblyName>
    <RootNamespace>DisplaySwitcher</RootNamespace>
    <!-- GetWindowLongPtrW only exists in 64-bit user32 -->
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- WHY: without per-monitor V2 awareness Windows virtualizes coordinates
         (a 4K panel at 125% reports as 3072x1728) and saved window rects are wrong. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Display Switcher</Product>
    <AssemblyTitle>Display Switcher</AssemblyTitle>
    <Copyright>Copyright (c) 2026 Joe Jenniges</Copyright>
    <!-- Satellite resource folders for 15 languages nobody here reads. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Kestrel instead of HttpListener: binding a non-localhost address with
         HttpListener needs a netsh urlacl reservation or admin rights. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="YamlDotNet" Version="16.1.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray and window icon; the same file is the exe icon via ApplicationIcon. -->
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

</Project>
